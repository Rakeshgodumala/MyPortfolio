# Copy to backend/.env and fill in. Never commit the real .env file.

NODE_ENV=development
PORT=5000

# Local: mongodb://127.0.0.1:27017/portfolio
# Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# How long an admin login lasts before the session expires.
SESSION_HOURS=2

# Comma-separated list of frontend origins allowed to call the API (no trailing slash).
# Production example: https://rakeshgodumala.vercel.app,https://www.your-domain.com
CLIENT_ORIGIN=http://localhost:5173

# lax: frontend and API share a site (local dev, or Vercel rewrites /api to the backend). Recommended.
# none: frontend and API on different sites (cookie is then Secure-only and may be blocked by some browsers).
COOKIE_SAMESITE=lax

# Number of reverse proxies in front of the API. Use 1 on Render.
TRUST_PROXY=0

# Persistent image storage (required in production). Found on the Cloudinary dashboard:
#   CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=

# Contact-form email delivery (optional; messages are always saved and visible in the dashboard).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_SECURE=true, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-character Google App Password>, not your normal Gmail password.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
CONTACT_TO_EMAIL=rakeshgodumala22@gmail.com
CONTACT_FROM_EMAIL=
